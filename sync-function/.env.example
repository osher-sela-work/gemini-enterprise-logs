# Settings of the sync function (index.js). On Cloud Run these are the service's environment variables:
# Containers tab -> Variables & Secrets. Cloud Run doesn't read a .env file; this lists what to set there.

# The Google Cloud project the Gemini Enterprise logs are written to
LOG_PROJECT=

# The report's bucket
BUCKET=icl-database

# The report's OAuth client ID (GCS_CLIENT_ID in src/app.js): only tokens issued to the report are accepted
CLIENT_ID=569858054254-dbnl4e84molmbp75odtf144i4rb266rv.apps.googleusercontent.com

# The organization's email domain; only its verified accounts can trigger a sync. Several: comma-separated
ALLOWED_DOMAIN=

# Optional: which logs to pull. The default (DEFAULT_FILTER in index.js) is the Logs Explorer export query plus
# gemini_enterprise_user_activity (its StreamAssist rows name the user of each Gemini Enterprise chat):
# LOG_FILTER=resource.type="discoveryengine.googleapis.com/Agent" OR resource.labels.service="google.cloud.notebooklm.v1main.NotebookService" OR resource.type="modelarmor.googleapis.com/SanitizeOperation" OR log_id("discoveryengine.googleapis.com/gemini_enterprise_user_activity")
