# Settings of the sync function (index.js). On Cloud Run these are the service's environment variables
# (Containers tab -> Variables & Secrets); Cloud Run doesn't read a .env file. terraform/ sets them from its variables.

# The Google Cloud project the Gemini Enterprise logs are written to
LOG_PROJECT=

# The report's bucket
BUCKET=

# The report's OAuth client ID (GCS_CLIENT_ID in src/app.js): only tokens issued to the report are accepted
CLIENT_ID=

# The organization's email domain; only its verified accounts can trigger a sync. Several: comma-separated
ALLOWED_DOMAIN=

# Optional: one Gemini Enterprise app's engine id (e.g. gemini-enterprise-myapp_1234567890123), so the project's
# other apps are left out. Empty: every app in the project.
GE_APP=

# Optional: which logs to pull, replacing the default (DEFAULT_FILTER in index.js) entirely; GE_APP then has no effect.
# LOG_FILTER=
